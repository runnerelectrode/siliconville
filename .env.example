# Copy to .env.local (gitignored) and fill in.
#
# Both values are PUBLIC by design — Vite inlines them into the client bundle,
# so anyone loading the site can read them. Neither is a credential. The Convex
# deploy key and your model API keys are secrets and never belong in this file;
# they live on the deployment (`npx convex env set ...`).

# Your Convex deployment. `npx convex dev` writes this for you.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional. Google OAuth client ID for "sign in with Google".
# Leave unset and the sign-in button simply does not render — the city, the
# interview and the scorecard all work signed out.
VITE_GOOGLE_CLIENT_ID=
